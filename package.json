{
  "name": "mf-updator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "tsx src/login.ts",
    "inspect": "tsx src/inspect.ts",
    "inspect:transfer": "tsx src/inspect.ts --transfer",
    "dry-run": "tsx src/untransfer.ts",
    "apply": "tsx src/untransfer.ts --apply",
    "untransfer": "tsx src/untransfer.ts",
    "dry-run:exclude": "tsx src/exclude-from-calculation.ts",
    "apply:exclude": "tsx src/exclude-from-calculation.ts --apply",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}